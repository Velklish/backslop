{
  "name": "backslop",
  "version": "0.20.0",
  "description": "A backlog for slop: a file-based task tracker and decision log next to the code, plus process skills for agents. Initialise any project with one command.",
  "type": "module",
  "bin": {
    "backslop": "bin/backslop.js"
  },
  "files": [
    "bin",
    "lib",
    "templates",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test --test-timeout=60000 --test-concurrency=2",
    "lint": "node bin/backslop.js lint",
    "release": "node scripts/release.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Velklish/backslop.git"
  },
  "license": "MIT",
  "keywords": [
    "backlog",
    "adr",
    "tasks",
    "agents",
    "claude-code",
    "cursor",
    "codex",
    "docs-as-code",
    "markdown"
  ],
  "homepage": "https://github.com/Velklish/backslop#readme"
}
